 	function sosial(){
				
        		var show=$(".list-sosial").css("display");
        	
        		if(show=="none"){
					$(".list-sosial").show(500);
					$(".list-sosial").css("display","block");
        			$(".tab_item-0").addClass("tab-active");
        			$(".sosial-more").text("Tutup");
        			
        		} else {
					$(".list-sosial").hide(500);
        			$(".tab_item-0").removeClass("tab-active");
        			$(".sosial-more").text("Selengkapnya...");
					$(".list-sosial").css("display","none");
        		}
        	}

        	function ekonomi(){
        		var show2=$(".list-ekonomi").css("display");
        		if(show2=="none"){
					$(".list-ekonomi").show(500);	
					$(".list-ekonomi").css("display","block");
        			$(".tab_item-1").addClass("tab-active");
        			$(".ekonomi-more").text("Tutup");
        		} else {
					$(".list-ekonomi").hide(500);
        			$(".tab_item-1").removeClass("tab-active");
        			$(".ekonomi-more").text("Selengkapnya...");
					$(".list-ekonomi").css("display","none");
        		}
        	}

        	function pertanian(){
        		var show3=$(".list-pertanian").css("display");
